# Fish Audio TTS. Скопируй в .env.local (в git не попадёт) и подставь свои значения.
# На Vercel те же переменные задаются в Project Settings -> Environment Variables.
# Подробности и цена — TTS_FISH_AUDIO.md.

# Ключ API из https://fish.audio/go-api/api-keys. Секрет: только в .env.local и в Vercel.
FISH_API_KEY=

# Голос по умолчанию для всего: reference_id модели голоса с fish.audio.
# Берётся из адреса страницы голоса: fish.audio/m/<ЭТО_И_ЕСТЬ_ID>
# Решение методиста 2026-08-05: один голос на всё, остальные переменные не задаём.
FISH_VOICE_M=

# Необязательно: отдельные голоса. Не заданы — используется FISH_VOICE_M.
# FISH_VOICE_F=
# FISH_VOICE_UZ_M=
# FISH_VOICE_UZ_F=
# FISH_VOICE_RU_M=
# FISH_VOICE_RU_F=
# FISH_VOICE_EN_M=
# FISH_VOICE_EN_F=

# Необязательно: модель и подача.
# s2.1-pro-free — бесплатный доступ к той же модели (Fair Use, без карты),
# заявлен до 31 августа 2026 года; без SLA и без гарантии задержки.
# FISH_MODEL=s2.1-pro-free
# FISH_SPEED=1
# FISH_LATENCY=normal
# FISH_MP3_BITRATE=64

# Необязательно: пускать к /api/tts только эти домены (через запятую, без схемы).
# Пусто — проверки нет, эндпоинт открыт всем, кто знает адрес.
# TTS_ALLOWED_HOSTS=

# Необязательно: разрешить /api/tts?text=...&debug=1 (показывает выбранный голос).
# TTS_DEBUG=1

# Включает боевой TTS во фронтенде. Без этой переменной сайт озвучивает уроки
# браузерным голосом, как сейчас. self = этот же сайт (/api/tts).
VITE_TTS_BASE=self
