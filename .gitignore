src/books/**/*.pdf

# Source snapshot archives (not pushed to GitHub).
*.rar
*.zip

# Manim lab render chiqishi (izolyatsiya)
src/lab/manim_dars01/media/

src/lab/grade3_dars01_manim/media/

# Python kesh (Manim lab)
__pycache__/
*.pyc

# Отладочные прогоны Playwright и временные скрипты (не для git).
# Каталог разрастается до сотен мегабайт и засоряет git status.
.tmp/
# Отдельные файлы, а не каталог: скриншоты и разовые скрипты проверки часто
# кладутся в корень как .tmp-что-то. Без этой строки их набирается несколько
# десятков и они уезжают в коммит по `git add -A`.
.tmp-*
artifacts/
test-results/

# Выходы отдельных сборок. Собираются командой, в git не хранятся.
# lms_dars01_3d_build/ пока ОТСЛЕЖИВАЕТСЯ — чтобы правило заработало,
# нужно один раз выполнить: git rm -r --cached lms_dars01_3d_build
lms_dars01_3d_build/
lms-grade3-standalone/
lms-grade3-practice-standalone/
lms-grade6-standalone/
lms-grade6-practice-standalone/
lms-grade4-standalone/
